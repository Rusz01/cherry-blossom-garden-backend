# ─────────────────────────────────────────────────────────────────────────────
# Arthanova Studio CMS — environment variables
# Copy to `.env` (or `.env.local`) and fill in values. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core (required) ──────────────────────────────────────────────────────────
# PostgreSQL connection string.
#   Local:  postgres://postgres:postgres@127.0.0.1:5432/arthanova_cms
#   Dokploy/VPS: postgres://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/arthanova_cms

# Signs auth tokens and encrypts data. ≥32 chars required in production.
# Generate: openssl rand -hex 32
PAYLOAD_SECRET=replace-with-output-of-openssl-rand-hex-32

# Public URL of this CMS (no trailing slash). Used in emails, previews, SEO.
APP_URL=http://localhost:3000

# ── Database (optional) ──────────────────────────────────────────────────────
# SSL: disable | require | verify-full   (use verify-full for remote databases when possible)
DATABASE_SSL=disable
# CA certificate for verify-full: PEM (with \n escapes) or base64-encoded PEM.
DATABASE_SSL_CA=
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000
# Development only: set to false to stop Payload auto-pushing schema changes.
PAYLOAD_DB_PUSH=true

# ── Email via Resend (required to send any email) ────────────────────────────
# Without RESEND_API_KEY + EMAIL_FROM_ADDRESS, emails are NOT sent: the attempt
# is logged and security-critical flows (invitations, password reset) fail loudly.
RESEND_API_KEY=
EMAIL_FROM_NAME=Arthanova Studio
# Must use a domain verified in Resend (e.g. no-reply@mail.yourdomain.com).
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=
# Shown as the support contact in emails (defaults to EMAIL_REPLY_TO).
EMAIL_SUPPORT_ADDRESS=
# Development only: write emails to ./.dev-outbox instead of sending (ignored in production).
EMAIL_DEV_OUTBOX=false
# Staging: redirect every outgoing email to this one address.
EMAIL_OVERRIDE_RECIPIENT=

# ── Website ──────────────────────────────────────────────────────────────────
# Used for "Visit website" links in the admin and emails.
WEBSITE_URL=https://arthanovastudio.com

# ── Scheduled publishing / jobs (optional) ───────────────────────────────────
# Runs Payload's job queue in-process (needed for scheduled publish/unpublish).
# Set to false on serverless hosts and call POST /api/payload-jobs/run instead.
JOBS_AUTORUN=true
JOBS_AUTORUN_CRON=* * * * *
# Bearer token allowed to trigger /api/payload-jobs/run from an external cron.
CRON_SECRET=

# ── Optional S3 / MinIO media storage ────────────────────────────────────────
# Leave S3_ENABLED=false to store uploads on the local filesystem (./media).
S3_ENABLED=false
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# MinIO requires path-style URLs.
S3_FORCE_PATH_STYLE=true
S3_PREFIX=
# Redirect downloads to short-lived pre-signed URLs instead of proxying.
S3_SIGNED_DOWNLOADS=false
S3_SIGNED_URL_EXPIRES_IN=3600

# ── Tests ────────────────────────────────────────────────────────────────────
# Disposable database for `pnpm test:int` — it is WIPED on every run.
# The name must end with `_test`.
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/arthanova_cms_test
